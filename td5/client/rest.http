### Add a new contact
POST http://localhost:5000/api/contacts
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjZhZWI1NTU5YWYzMmYxMmZiNjBhZDIyMiIsImVtYWlsIjoiYWRtaW5AZXhhbXBsZS5jb20iLCJpYXQiOjE3OTM4MDc3NDQsImV4cCI6MTc5Mzg5NDE0NH0.30KBQU0L4gAjwlawXJvDSOsWkH6ab46dPlsjHJVUp8c

{
