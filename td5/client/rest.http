    "age": 30
}

### Update an existing contact
PUT http://localhost:5000/api/contacts/6ace007a57ba480dd70b6777
Content-Type: application/json

{
    "name": "Alain",
    "age": 31
}

### Delete a contact
DELETE http://localhost:5000/api/contacts/6aeb010fb0852324e0ce65fa